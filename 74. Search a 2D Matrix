class Solution(object):
    def searchMatrix(self, matrix, target):
        n = len(matrix[0])
        r = 0
        l = (len(matrix) * n ) - 1
        while r<=l:
            mid = (r+l)//2
            numb = matrix[mid//n][mid%n]
            if numb == target:
                return True
            elif numb > target:
                l = mid - 1
            else:
                r = mid + 1
        return False
